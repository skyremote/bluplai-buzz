# Copy to env.production. Never commit the populated file.

# Immutable, audited fork image. Tags (including sha-* tags) are rejected.
BUZZ_IMAGE=ghcr.io/bluplai/buzz@sha256:CHANGE_ME_64_LOWERCASE_HEX
CADDY_IMAGE=caddy@sha256:CHANGE_ME_64_LOWERCASE_HEX

# Immutable host-derivation namespace. Changing either value creates a different
# deterministic host for the same organisation chat key.
BLUPLAI_ENVIRONMENT=production
BLUPLAI_COMMUNITY_BASE_DOMAIN=chat.bluplai.com
BLUPLAI_RELAY_CONTROL_HOST=relay.chat.bluplai.com
BLUPLAI_BROWSER_ORIGIN=https://app.bluplai.com

# Directory on the Docker host containing tls.crt + tls.key for the control host
# and wildcard community certificate.
BLUPLAI_TLS_CERT_DIR=/srv/bluplai-buzz/tls

# External, durable dependencies. Do not point production at Compose-local state.
DATABASE_URL=postgresql://CHANGE_ME?sslmode=require
READ_DATABASE_URL=
REDIS_URL=rediss://CHANGE_ME
BUZZ_S3_ENDPOINT=https://CHANGE_ME
BUZZ_S3_REGION=eu-central-1
BUZZ_S3_ADDRESSING_STYLE=virtual
BUZZ_S3_ACCESS_KEY=CHANGE_ME
BUZZ_S3_SECRET_KEY=CHANGE_ME
BUZZ_S3_BUCKET=bluplai-buzz-production

# Relay identity and operator controls. Keep private key material in the platform
# secret store; values are shown here only to document required names.
RELAY_URL=wss://relay.chat.bluplai.com
BUZZ_MEDIA_BASE_URL=https://relay.chat.bluplai.com/media
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_AUTO_MIGRATE=false
BUZZ_CORS_ORIGINS=https://app.bluplai.com
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX
RELAY_OPERATOR_API_ORIGIN=https://relay.chat.bluplai.com
RELAY_OPERATOR_PUBKEYS=CHANGE_ME_64_HEX
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info
