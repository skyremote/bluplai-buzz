{
  "name": "@bluplai/buzz-chat-react",
  "version": "0.1.0-bluplai.4",
  "description": "Browser-native Bluplai Chat surface powered by Buzz",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/verify-browser-package.mjs",
    "check": "biome check src scripts package.json tsconfig.json tsconfig.build.json vite.config.ts vitest.config.ts && tsc --noEmit && node scripts/check-browser-boundaries.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^27.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  }
}
